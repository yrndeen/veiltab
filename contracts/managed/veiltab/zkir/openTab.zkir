{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%total.0", "type": "Scalar<BLS12-381>" },
    { "name": "%participantCount.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%total.0", "bits": 64 },
    { "op": "constrain_bits", "val": "%participantCount.1", "bits": 8 },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.2", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x03"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x01", "%t.2"] },
    { "op": "test_eq", "output": "%t.3", "a": "%t.2", "b": "0x00" },
    { "op": "assert", "cond": "%t.3" },
    { "op": "less_than", "output": "%t.4", "a": "0x00", "b": "%total.0", "bits": 64 },
    { "op": "assert", "cond": "%t.4" },
    { "op": "less_than", "output": "%t.5", "a": "%participantCount.1", "b": "0x01", "bits": 8 },
    { "op": "less_than", "output": "%t.6", "a": "0x04", "b": "%participantCount.1", "bits": 8 },
    { "op": "cond_select", "output": "%t.7", "bit": "%t.6", "a": "0x00", "b": "0x01" },
    { "op": "cond_select", "output": "%t.8", "bit": "%t.5", "a": "0x00", "b": "%t.7" },
    { "op": "assert", "cond": "%t.8" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x08", "%total.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%participantCount.1"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x03"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x0a"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x08"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x09"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x08", "0x00"] },
